{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "richievdheij/laravel-starter-template",
  "type": "project",
  "description": "Private Laravel 13 starter template: one make front door, one gate list, a checked environment contract. All rights reserved.",
  "keywords": [
    "laravel",
    "starter",
    "template",
    "toolchain"
  ],
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "laravel/framework": "^13.0",
    "laravel/tinker": "^3.0"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7",
    "driftingly/rector-laravel": "^2.6",
    "fakerphp/faker": "^1.23",
    "larastan/larastan": "^3.11",
    "laravel/boost": "2.8.0",
    "laravel/pail": "^1.2.5",
    "laravel/pao": "^1.0.6",
    "laravel/pint": "^1.31",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^5.1",
    "pestphp/pest-plugin-browser": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-phpstan": "^5.2",
    "rector/rector": "^2.6",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "setup": [
      "Composer\\Config::disableProcessTimeout",
      "@composer install --no-interaction --prefer-dist",
      "npm ci",
      "git config core.hooksPath .githooks",
      "git config commit.template .gitmessage",
      "node scripts/herd.mjs",
      "node scripts/env.mjs local",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --seed --no-interaction",
      "npm run build",
      "node scripts/site.mjs"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "node scripts/site.mjs --dev",
      "@php artisan dev"
    ],
    "test": [
      "@php artisan test --testsuite=Unit,Feature,Arch"
    ],
    "refresh": [
      "Composer\\Config::disableProcessTimeout",
      "node scripts/update.mjs"
    ],
    "verify": "make verify",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "pre-package-uninstall": [
      "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
    ]
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "audit": {
      "abandoned": "report"
    },
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts-descriptions": {
    "setup": "Install everything a fresh clone needs, link it in Herd, migrate, seed and build",
    "dev": "Live Vite, queue and logs, plus artisan serve when Herd does not serve the site",
    "test": "Run the Unit, Feature and Arch suites",
    "refresh": "Bring dependencies, database and assets up to date after a pull"
  }
}
