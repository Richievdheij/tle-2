#!/usr/bin/env sh
# After switching branches: the same update as after a pull, so the site Herd
# serves matches the branch that is checked out. scripts/update.mjs explains what
# it does and why it is cheap when nothing changed.
#
# $1 and $2 are the old and new HEAD, $3 is 1 for a branch checkout and 0 for a
# file checkout (`git checkout -- <file>`), which must not trigger a rebuild.

[ "$3" = 1 ] || exit 0
[ "$1" != "$2" ] || exit 0

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 0

# Mid-rebase every replayed commit is a checkout; the update runs once it is done.
git_dir="$(git rev-parse --git-dir)"
[ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ] && exit 0

# A fresh clone or a new worktree has not run `make install` yet.
[ -f vendor/autoload.php ] || exit 0

node scripts/update.mjs ||
  printf "\033[1;31m✗\033[0m %s\n" "Updating after the checkout failed — fix the above, then run 'composer run refresh' or 'make update'"
exit 0
